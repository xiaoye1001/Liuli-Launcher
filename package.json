{
  "name": "mc_launcher",
  "version": "0.4.6",
  "description": "琉璃启动器（Liuli Launcher）：现代化的跨平台 Minecraft Java 版启动器",
  "main": "./out/main/index.js",
  "author": "xiaoye1001",
  "license": "MIT",
  "homepage": "https://github.com/xiaoye1001/Liuli-Launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoye1001/Liuli-Launcher.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoye1001/Liuli-Launcher/issues"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "react",
    "modrinth",
    "curseforge"
  ],
  "private": true,
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:win": "npm run build && electron-builder --win",
    "build:win:setup": "npm run build && electron-builder --win nsis",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:unpack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/file-transfer": "2.0.3",
    "@xmcl/installer": "6.1.2",
    "@xmcl/mod-parser": "3.4.2",
    "@xmcl/system": "2.2.9",
    "@xmcl/task": "4.1.1",
    "@xmcl/unzip": "2.1.2",
    "@xmcl/user": "4.3.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.460.0",
    "postcss": "8.5.31",
    "prettier": "3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "skinview3d": "3.4.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "overrides": {
    "@xmcl/file-transfer": {
      "undici": "$undici"
    },
    "@xmcl/installer": {
      "undici": "$undici"
    },
    "@xmcl/user": {
      "undici": "$undici",
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
